# --- OpenRouter (облачный профиль) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Необязательно: попадают в заголовки запроса и в статистику OpenRouter
OPENROUTER_APP_URL=https://github.com/<user>/sap-explanation-agent
OPENROUTER_APP_TITLE=SAP Explanation Agent

# --- Ollama (эмбеддинги во всех профилях, генерация в local и hybrid) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Длина контекста задаётся СЕРВЕРУ Ollama, а не этому процессу — здесь только
# напоминание. Промпты агента доходят до 3–6 тысяч токенов, а Ollama обрезает
# промпт до num_ctx молча. Перед запуском локального профиля:
#   Windows (PowerShell):  $env:OLLAMA_CONTEXT_LENGTH=8192; ollama serve
#   или разово в Modelfile:  PARAMETER num_ctx 8192
# Проверить фактически: python -m app.runner --selftest — там есть проверка
# «длина контекста», она кладёт метку в начало длинного промпта.

# --- Профиль моделей: local | hybrid | cloud ---
SAP_AGENT_PROFILE=hybrid

# --- Векторная память ---
# Бэкенд: qdrant (по умолчанию) | numpy (запасной, без гибридного поиска)
SAP_AGENT_MEMORY_BACKEND=qdrant
# Адрес сервера Qdrant. Если оставить пустым, используется встроенный режим по QDRANT_PATH:
# он не требует сервера, но не создаёт индексы по payload.
QDRANT_URL=
QDRANT_API_KEY=
# Каталог встроенного режима. Значение :memory: — база в оперативной памяти (для тестов).
QDRANT_PATH=memory/store/qdrant
